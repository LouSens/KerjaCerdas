server {
    listen 3000;
    server_name _;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Static SPA assets
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # API endpoints reverse proxy
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Proves to the API that X-Real-IP above came from us, not from a
        # client hitting the API's own published port directly — see
        # backend/app/config/settings.py's proxy_shared_secret. Empty by
        # default (unset PROXY_SHARED_SECRET), which drops the header
        # entirely rather than sending it blank.
        proxy_set_header X-Internal-Proxy-Secret "${PROXY_SHARED_SECRET}";
    }

    # Health check endpoint reverse proxy
    location /health {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Proves to the API that X-Real-IP above came from us, not from a
        # client hitting the API's own published port directly — see
        # backend/app/config/settings.py's proxy_shared_secret. Empty by
        # default (unset PROXY_SHARED_SECRET), which drops the header
        # entirely rather than sending it blank.
        proxy_set_header X-Internal-Proxy-Secret "${PROXY_SHARED_SECRET}";
    }
}
