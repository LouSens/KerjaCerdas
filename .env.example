# KerjaCerdas — environment variables
# Copy to .env and fill in real values.
# RULE-01: Never commit .env to git.

# ── Google Gemini / Vertex AI ────────────────────────────────────────────────
# Pick ONE auth path:
#  (a) Gemini AI Studio — set GEMINI_API_KEY (https://aistudio.google.com/apikey)
#  (b) Vertex AI        — set VERTEX_AI_PROJECT + VERTEX_AI_LOCATION
#                          and authenticate with `gcloud auth application-default login`
#                          OR set GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1

# Models — Gemini 3.1 Flash Lite for chat/parsing, Gemini Embedding 2 (= gemini-embedding-001) for vectors
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Output dim — Gemini Embedding 2 supports 768/1536/3072 via Matryoshka truncation
GEMINI_EMBED_DIM=3072

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
# Dev:      leave blank → auto SQLite under data/
# Local PG: postgresql+asyncpg://postgres:postgres@localhost:5432/kerjacerdas
# Supabase: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#           Use port 5432 for direct (Alembic migrations).
#           Use port 6543 (Supavisor session mode) for the running app to avoid connection exhaustion.
#           Append ?ssl=require if you get an SSL error.
DATABASE_URL=

# ── Data storage root (dev JSON store) ───────────────────────────────────────
# Where JSON files are written. Default: data/ next to project root.
KERJA_DATA_ROOT=data

# ── Redis (optional) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# ── Matching tuning ───────────────────────────────────────────────────────────
MATCHING_TOP_K=10
MATCHING_REGION_WEIGHT=0.10
MATCHING_SALARY_WEIGHT=0.05
MATCHING_SKILL_WEIGHT=0.30
MATCHING_COSINE_WEIGHT=0.50

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# LangSmith Tracing & Telemetry
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="KerjaCerdas"
LANGCHAIN_API_KEY=

# ── VPS Production Deployment (docker-compose.prod.yml) ──────────────────────
# GitHub username / org that owns the repo — images are pushed to ghcr.io/$GHCR_OWNER
GHCR_OWNER=LouSens
# The Docker image tag to deploy — set to a specific version like v1.2.3 or leave as 'latest'
IMAGE_TAG=latest
# The public-facing URL of the API as seen from a browser (used by frontend)
PROD_API_URL=http://YOUR_VPS_IP:8000
# Comma-separated allowed origins for CORS. Must match your frontend URL.
CORS_ALLOW_ORIGINS=["http://YOUR_VPS_IP:3000"]
