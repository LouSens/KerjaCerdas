# KerjaCerdas — environment variables
# Copy to .env and fill in real values.
# RULE-01: Never commit .env to git.

# ── Google Gemini / Vertex AI ────────────────────────────────────────────────
# Pick ONE auth path:
#  (a) Gemini AI Studio — set GEMINI_API_KEY (https://aistudio.google.com/apikey)
#  (b) Vertex AI        — set VERTEX_AI_PROJECT + VERTEX_AI_LOCATION
#                          and authenticate with `gcloud auth application-default login`
#                          OR set GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1

# Models — keep GEMINI_EMBED_MODEL identical to settings.py's default.
#
# CHANGING GEMINI_EMBED_MODEL IS A MIGRATION, NOT A CONFIG TWEAK. matcher.py
# refuses to compare vectors across models (cosine between two different vector
# spaces is meaningless), so every row still tagged with the old model scores 0
# on the cosine term — 45% of the match score — until it is re-embedded. After
# changing it, run:  cd backend && python -m scripts.reembed
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-1
# Output dim — supports 768/1536/3072 via Matryoshka truncation.
# Must stay 768 to match the vector(768) pgvector column.
GEMINI_EMBED_DIM=768

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
# Dev:      leave blank → auto SQLite under data/
# Local PG: postgresql+asyncpg://postgres:postgres@localhost:5432/kerjacerdas
# Supabase: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#           Use port 5432 for direct (Alembic migrations).
#           Use port 6543 (Supavisor session mode) for the running app to avoid connection exhaustion.
#           Append ?ssl=require if you get an SSL error.
DATABASE_URL=

# ── Data storage root (dev JSON store) ───────────────────────────────────────
# Where JSON files are written. Default: data/ next to project root.
KERJA_DATA_ROOT=data

# ── Redis (optional) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
# Demo mode: lifts usage quotas and per-IP usage rate limits, and enables the
# one-click demo logins (/auth/demo-login). Login / register / OTP throttles
# and AutoMod strikes are never lifted. Unset = follows APP_ENV (on in
# development, off in production) — set DEMO_MODE=true on the booth deployment.
# DEMO_MODE=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# ── Matching tuning ───────────────────────────────────────────────────────────
# The score weights themselves (cosine / proof-weighted skill / experience /
# education) are constants in matcher.py, not env vars — see its docstring.
MATCHING_TOP_K=10
BAND_STRONG_THRESHOLD=0.65
BAND_POSSIBLE_THRESHOLD=0.45
MATCHING_FULL_SCAN_SAFE_LIMIT=500

# ── Email verification (the only identity check; no NIK/KTP/NPWP) ────────────
# With RESEND_API_KEY set, OTP codes are emailed (free tier: 3,000/month).
# Without it, the code is only returned in the response while OTP demo mode is
# on — leave OTP_DEMO_MODE unset so it follows APP_ENV (off in production).
RESEND_API_KEY=
EMAIL_FROM="KerjaCerdas <no-reply@kerjacerdas.tech>"
# OTP_DEMO_MODE=false

# ── Admin surface ─────────────────────────────────────────────────────────────
# BOTH are required: the flag on, and the signed-in account's email listed here.
ADMIN_ROUTES_ENABLED=true
# Any account email may be an admin — it does NOT have to be a real mailbox
# on the company domain. Your own address works.
ADMIN_EMAILS=["admin@kerjacerdas.tech"]

# ── Trust & moderation ────────────────────────────────────────────────────────
# Hold an employer's first posting for admin review unless they already have a
# company-domain email or the "Ditinjau admin" badge.
MODERATION_FIRST_JOB_REVIEW=true
MODERATION_REPORT_THRESHOLD=3

# ── Plans (IDR) ──────────────────────────────────────────────────────────────
PLAN_PRICE_BEACON=49000
PLAN_PRICE_LIGHTHOUSE=149000
PLAN_PRICE_PRISM=15000
# Paid plans are OFF: nothing is sold and no plan-based limit applies
# (advisor quota, candidate searches, active jobs). Only turn both on together.
PAID_PLANS_ENABLED=false
PLAN_LIMITS_ENFORCED=false
SPARK_RANKED_APPLICANT_LIMIT=0

# ── Cost reporting (GET /api/v1/admin/metrics) ───────────────────────────────
# Rupiah per USD used to convert Gemini token prices into the cost report.
USD_TO_IDR=17600

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# LangSmith Tracing & Telemetry
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="KerjaCerdas"
LANGCHAIN_API_KEY=

# ── VPS Production Deployment (docker-compose.prod.yml) ──────────────────────
# GitHub username / org that owns the repo — images are pushed to ghcr.io/$GHCR_OWNER
GHCR_OWNER=LouSens
# The Docker image tag to deploy — set to a specific version like v1.2.3 or leave as 'latest'
IMAGE_TAG=latest
# The public-facing URL of the API as seen from a browser (used by frontend)
PROD_API_URL=http://YOUR_VPS_IP:8000
# Comma-separated allowed origins for CORS. Must match your frontend URL.
CORS_ALLOW_ORIGINS=["http://YOUR_VPS_IP:3000"]
