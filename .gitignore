# ─── KerjaCerdas .gitignore ───────────────────────────────────────────────────

# Environment & Secrets (RULE-01)
.env
*.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/

# ML Models (NEVER commit model weights - PROTOCOL §6)
models/*.pt
models/*.onnx
models/*.bin
*.h5

# Database
database/*
!database/init.sql

# Reports (generated output)
reports/


# Node (frontend)
node_modules/
.next/
frontend/dist/

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# Agents config (local)
.agents/
.claude/
frontend/node_modules

# UI Design Cache
.design-cache/

# Local Data & Scratch
backend/data/
scripts/fix_*.py